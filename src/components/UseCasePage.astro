---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  lang: 'en' | 'fr';
  title: string;
  description: string;
  canonical: string;
  tags?: string[];
  items: string[];
  exampleTitle?: string;
  exampleIntro?: string;
  exampleSteps?: string[];
  alternates?: Array<{ lang: 'en' | 'fr' | 'x-default'; href: string }>;
}

const { lang, title, description, canonical, tags = [], items, exampleTitle, exampleIntro, exampleSteps, alternates } = Astro.props;
const isEn = lang === 'en';
const useCaseLabel = isEn ? 'Use case' : 'Cas d’usage';
const characteristicsLabel = isEn ? 'Characteristics' : 'Points clés';
const tagsLabel = isEn ? 'Keywords' : 'Mots-clés';
---
<BaseLayout
  lang={lang}
  title={`${title} | Repero AI`}
  description={description}
  canonical={canonical}
  alternates={alternates}
>
  <Header lang={lang} />
  <main class="page-shell flex-1 pb-12 pt-10">
    <section class="surface">
      <p class="eyebrow">{useCaseLabel}</p>
      <div class="mt-8 grid gap-6 md:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] md:items-start">
        <div>
          <h1 class="text-4xl font-bold text-white md:text-5xl">{title}</h1>
          <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">{description}</p>
          {tags.length ? (
            <>
              <p class="eyebrow mt-8">{tagsLabel}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </>
          ) : null}
          <p class="eyebrow mt-8">{characteristicsLabel}</p>
          <ul class="mt-4 flex flex-col gap-3">
            {items.map((item) => (
              <li class="rounded-xl border border-slate-800 bg-slate-950/60 px-4 py-3 text-slate-200">{item}</li>
            ))}
          </ul>
        </div>
        {exampleTitle && exampleSteps?.length ? (
          <div class="rounded-2xl border border-sky-500/20 bg-sky-500/10 p-6">
            <p class="eyebrow">{exampleTitle}</p>
            {exampleIntro ? <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-300">{exampleIntro}</p> : null}
            <ol class="mt-5 space-y-3">
              {exampleSteps.map((step, index) => (
                <li class="rounded-xl border border-slate-800 bg-slate-950/70 px-4 py-3 text-sm leading-7 text-slate-200">
                  <span class="mr-2 font-semibold text-sky-300">{index + 1}.</span>
                  {step}
                </li>
              ))}
            </ol>
          </div>
        ) : null}
      </div>
    </section>
  </main>
  <Footer lang={lang} />
</BaseLayout>
