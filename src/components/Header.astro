---
interface Props {
  lang: 'en' | 'fr';
  alternateHref?: string;
}

const { lang, alternateHref } = Astro.props;
const isEn = lang === 'en';
---
<header class="page-shell py-5">
  <div class="flex flex-col gap-3 rounded-2xl border border-slate-800/80 bg-slate-950/60 px-4 py-3 shadow-[0_14px_40px_rgba(0,0,0,0.18)] backdrop-blur md:flex-row md:items-center md:justify-between">
    <a href={isEn ? '/en' : '/fr'} class="flex items-center gap-3 self-start text-lg font-bold tracking-tight">
      <img
        src="/brand/flat-web/repero-mark-flat-inverted-transparent.svg"
        alt=""
        aria-hidden="true"
        class="h-9 w-9 shrink-0"
        width="36"
        height="36"
      />
      <span>Repero AI</span>
    </a>
    <nav class="flex w-full flex-wrap items-center gap-2 text-sm text-slate-300 md:w-auto md:justify-end">
      <a class="whitespace-nowrap rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href={isEn ? '/en/use-cases' : '/fr/cas-usages'}>{isEn ? 'Use cases' : 'Cas d’usage'}</a>
      {isEn && <a class="whitespace-nowrap rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href="/en/how-it-works">How it works</a>}
      {isEn && <a class="whitespace-nowrap rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href="/en/guide">Guide</a>}
      {isEn && <a class="whitespace-nowrap rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href="/en/blog">Blog</a>}
      {!isEn && <a class="whitespace-nowrap rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href="/fr/comment-ca-marche">Comment ça marche</a>}
      {!isEn && <a class="whitespace-nowrap rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href="/fr/guide">Guide</a>}
      {!isEn && <a class="whitespace-nowrap rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href="/fr/blog">Blog</a>}
      <a class="whitespace-nowrap rounded-full px-3 py-2 hover:bg-slate-800/70 hover:text-white" href="https://app.repero.ai">{isEn ? 'Access' : 'Accès'}</a>
      <a class="chip whitespace-nowrap md:ml-1" href={alternateHref ?? (isEn ? '/fr' : '/en')}>{isEn ? 'FR' : 'EN'}</a>
    </nav>
  </div>
</header>
