---
import { BRAND_LOGO, DEFAULT_OG_IMAGE, SITE_NAME, SITE_URL, absoluteUrl } from '../config/site';

interface AlternateLink {
  lang: 'en' | 'fr' | 'x-default';
  href: string;
}

interface Props {
  title: string;
  description: string;
  canonical: string;
  lang: 'en' | 'fr';
  ogType?: string;
  ogImage?: string;
  twitterCard?: 'summary' | 'summary_large_image';
  alternates?: AlternateLink[];
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const OG_LOCALE_BY_LANG = {
  en: 'en_US',
  fr: 'fr_FR'
} as const;

const {
  title,
  description,
  canonical,
  lang,
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  twitterCard = 'summary_large_image',
  alternates = [],
  article,
  schema
} = Astro.props;

const siteBase = SITE_URL;
const canonicalUrl = absoluteUrl(canonical, siteBase);
const ogImageUrl = absoluteUrl(ogImage, siteBase);
const faviconUrl = absoluteUrl('/brand/flat-web/favicon.ico', siteBase);
const favicon16Url = absoluteUrl('/brand/flat-web/favicon-16x16.png', siteBase);
const favicon32Url = absoluteUrl('/brand/flat-web/favicon-32x32.png', siteBase);
const appleTouchIconUrl = absoluteUrl('/brand/flat-web/apple-touch-icon-180x180.png', siteBase);
const brandIconUrl = absoluteUrl(BRAND_LOGO, siteBase);
const hreflangs = [{ lang, href: canonicalUrl }, ...alternates];

const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE_NAME,
  url: siteBase,
  logo: brandIconUrl,
  image: ogImageUrl
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: siteBase,
  image: ogImageUrl
};
const schemaList = [
  organizationJsonLd,
  websiteJsonLd,
  ...(Array.isArray(schema) ? schema : schema ? [schema] : [])
];
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
<link rel="icon" href={faviconUrl} sizes="any" />
<link rel="icon" href={favicon32Url} type="image/png" sizes="32x32" />
<link rel="icon" href={favicon16Url} type="image/png" sizes="16x16" />
<link rel="apple-touch-icon" href={appleTouchIconUrl} sizes="180x180" />
{hreflangs.map((link) => (
  <link rel="alternate" hreflang={link.lang} href={link.href} />
))}
<meta name="theme-color" content="#050a1c" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:locale" content={OG_LOCALE_BY_LANG[lang]} />
{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
{article?.author && <meta property="article:author" content={article.author} />}
{article?.section && <meta property="article:section" content={article.section} />}
{article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
<meta name="twitter:card" content={twitterCard} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<script type="application/ld+json" set:html={JSON.stringify(schemaList)} />
