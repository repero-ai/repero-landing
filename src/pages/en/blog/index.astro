---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getAlternateLocalePath } from '../../../lib/locale';
import { buildBlogIndexPath, buildBlogPostPath, formatBlogDate, getPublishedBlogPosts, getReadingTimeMinutes } from '../../../lib/blog';
import { BRAND_LOGO, DEFAULT_OG_IMAGE, SITE_URL, absoluteUrl } from '../../../config/site';

const site = SITE_URL;
const posts = await getPublishedBlogPosts('en');
const canonical = new URL(buildBlogIndexPath('en'), site).href;
const alternates = [{ lang: 'fr', href: new URL(buildBlogIndexPath('fr'), site).href }];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'The Repero AI blog',
  description: 'Practical perspectives on AI at work, knowledge organization, conversations, and reusable artifacts.',
  inLanguage: 'en-US',
  url: canonical,
  publisher: {
    '@type': 'Organization',
    name: 'Repero AI',
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl(BRAND_LOGO)
    }
  },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    url: new URL(buildBlogPostPath(post), site).href,
    image: absoluteUrl(post.data.image ?? DEFAULT_OG_IMAGE),
    author: {
      '@type': 'Person',
      name: post.data.author
    }
  }))
};
---
<BaseLayout
  lang="en"
  title="The Repero AI blog | AI, work, and knowledge organization"
  description="Practical perspectives on AI at work, knowledge organization, conversations, and reusable artifacts."
  canonical={canonical}
  alternates={alternates}
  ogType="website"
  twitterCard="summary_large_image"
  schema={schema}
>
  <Header lang="en" alternateHref={getAlternateLocalePath('en', alternates)} />
  <p class="page-shell pt-2 text-sm text-slate-400">Translated and adapted from French by AI.</p>
  <main class="page-shell pb-12">
    <section class="section-shell px-6 py-10 md:px-10 md:py-14">
      <div class="max-w-3xl space-y-5">
        <p class="eyebrow">Blog</p>
        <h1 class="headline text-4xl md:text-5xl">The Repero AI blog</h1>
        <p class="lead max-w-3xl text-lg md:text-xl">
        AI, productivity, and knowledge management: practical perspectives for organizing, finding, and using information.
        </p>
      </div>
    </section>

    <section class="section-shell mt-8 px-6 py-8 md:px-8 md:py-10">
      <p class="eyebrow">Practical guides</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white">Three ways to give AI work a clearer frame.</h2>
      <div class="mt-7 grid gap-4 md:grid-cols-3">
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/en/organize-ai-conversations"><h3 class="text-xl font-semibold text-white">Organize AI conversations</h3><p class="mt-3 text-sm leading-7 text-slate-300">Find useful answers again and turn them into durable work.</p></a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/en/secure-ai-for-small-business"><h3 class="text-xl font-semibold text-white">Use AI in a small business</h3><p class="mt-3 text-sm leading-7 text-slate-300">Work with AI without losing sight of business data.</p></a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/en/european-chatgpt-alternative"><h3 class="text-xl font-semibold text-white">GPT, Claude and Mistral in Repero</h3><p class="mt-3 text-sm leading-7 text-slate-300">Switch AI models without scattering projects and documents.</p></a>
      </div>
    </section>

    <section class="mt-8 grid gap-5">
      {posts.map((post) => {
        const href = buildBlogPostPath(post);
        const readingTime = getReadingTimeMinutes(post.body);

        return (
          <article class="feature-card">
            <div class="flex flex-wrap items-center gap-3 text-sm text-slate-400">
              <span class="chip">{post.data.category}</span>
              <span>{formatBlogDate(post.data.pubDate, 'en-US')}</span>
              <span>{readingTime} min read</span>
            </div>
            <h2 class="mt-4 text-2xl font-semibold text-white">
              <a class="hover:text-sky-300" href={href}>{post.data.title}</a>
            </h2>
            <p class="mt-3 max-w-3xl text-base leading-7 text-slate-300">{post.data.description}</p>
            <div class="mt-5">
              <a class="btn-secondary" href={href}>Read article</a>
            </div>
          </article>
        );
      })}
    </section>
  </main>
  <Footer lang="en" />
</BaseLayout>
