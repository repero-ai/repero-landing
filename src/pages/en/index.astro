---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { frProductScreens } from '../../data/frProductScreens';
const site = 'https://repero.ai';
const canonical = new URL('/en', site).href;
const alternates = [{ lang: 'fr', href: new URL('/fr', site).href }];
const heroScreen = frProductScreens.find((screen) => screen.id === 'active-context');
---
<BaseLayout
  lang="en"
  title="Repero AI | A European AI workspace for work that lasts"
  description="Bring conversations, documents, research and generated content together in organised AI workspaces, hosted in Europe."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="en" />
  <main class="page-shell pb-12">
    <section class="grid gap-8 py-8 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-14">
      <div class="space-y-6">
        <p class="eyebrow">European AI workspace</p>
        <h1 class="headline">Work with AI without losing your ideas — or control of your data.</h1>
        <p class="lead">Tired of finding your work scattered across AI conversations? Repero AI turns your AI exchanges into organized working documents. Switch between GPT, Claude and Mistral, edit your content and pick up your projects where you left off.</p>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Try Repero AI for free</a>
          <a class="btn-secondary" href="/en/how-it-works">See how it works</a>
        </div>
      </div>

      {heroScreen && (
        <div class="surface p-4 md:p-5">
          <div class="overflow-hidden rounded-[1.75rem] border border-slate-800 bg-slate-950/70 shadow-[0_24px_60px_rgba(2,132,199,0.14)]">
            <img
              src={heroScreen.image}
              alt="Repero AI workspace showing active context, sources and generated content."
              class="aspect-[16/10] w-full object-cover object-top"
              width="1440"
              height="960"
              loading="eager"
            />
          </div>
        </div>
      )}
    </section>

    <section class="grid gap-4 py-8 md:grid-cols-3 md:py-12" aria-label="Repero AI benefits">
      <article class="feature-card">
        <h2 class="text-2xl font-semibold text-white">Turn conversations into real documents.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Stop spending time copying and pasting. Keep useful answers, turn them into documents, then edit them directly in your workspace.</p>
      </article>
      <article class="feature-card">
        <h2 class="text-2xl font-semibold text-white">GPT, Claude and Mistral in one place.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Switch between them according to your needs, without changing tools or scattering your work.</p>
      </article>
      <article class="feature-card">
        <h2 class="text-2xl font-semibold text-white">Your data stays under lock and key.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Your projects, conversations and documents are encrypted and hosted in Europe. And if you want to go further, you can protect a personal workspace with your own encryption key.*</p>
        <p class="mt-3 text-xs leading-6 text-slate-400">* Available for personal workspaces. By default, Repero already protects your data with platform-managed encryption.</p>
      </article>
    </section>

    <section class="section-shell px-6 py-8 md:px-8 md:py-10">
      <p class="eyebrow">For different ways of working</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white md:text-4xl">One workspace for work that matters.</h2>
      <div class="mt-7 grid gap-4 md:grid-cols-3">
        <article class="feature-card">
          <h3 class="text-xl font-semibold text-white">Freelancers &amp; creators</h3>
          <p class="mt-3 text-sm leading-7 text-slate-300">Keep client projects, research, content and deliverables in distinct workspaces.</p>
        </article>
        <article class="feature-card">
          <h3 class="text-xl font-semibold text-white">Teams and small businesses</h3>
          <p class="mt-3 text-sm leading-7 text-slate-300">Structure AI work, share a consistent way of working and retain control of business data.</p>
        </article>
        <article class="feature-card">
          <h3 class="text-xl font-semibold text-white">Document work</h3>
          <p class="mt-3 text-sm leading-7 text-slate-300">Move from an AI conversation to persistent content you can edit and reuse.</p>
        </article>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</BaseLayout>
