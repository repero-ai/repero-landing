---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const site = 'https://repero.ai';
const canonical = new URL('/en', site).href;
const alternates = [{ lang: 'fr', href: new URL('/fr', site).href }];
---
<BaseLayout
  lang="en"
  title="Repero AI | Your AI work, finally organized"
  description="European-first AI workspace to keep, organize and retrieve AI work."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="en" />
  <main class="page-shell pb-12">
    <section class="grid gap-8 py-8 md:grid-cols-[1.15fr_.85fr] md:items-center md:py-14">
      <div class="space-y-6">
        <p class="eyebrow">European-first AI workspace</p>
        <h1 class="headline">Your AI work, finally organized.</h1>
        <p class="lead">Repero AI helps users keep, organize and retrieve what they search, upload, generate and decide with AI.</p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary" href="https://app.repero.ai" target="_blank">Access Repero AI</a>
          <a class="btn-secondary" href="/en/use-cases">Explore use cases</a>
        </div>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="chip">Search</span>
          <span class="chip">Upload</span>
          <span class="chip">Generate</span>
          <span class="chip">Decide</span>
        </div>
      </div>

      <div class="surface relative overflow-hidden">
        <div class="absolute -right-12 -top-12 h-40 w-40 rounded-full bg-sky-500/15 blur-3xl"></div>
        <div class="absolute -left-10 bottom-0 h-40 w-40 rounded-full bg-emerald-400/10 blur-3xl"></div>
        <div class="relative space-y-4">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-slate-100">Workspace overview</p>
              <p class="text-xs text-slate-400">A calm surface for memory, conversations and artefacts.</p>
            </div>
            <span class="chip">Live memory</span>
          </div>
          <div class="rounded-2xl border border-sky-500/20 bg-sky-500/10 p-4">
            <p class="text-sm font-semibold text-sky-100">Capture what matters</p>
            <p class="mt-1 text-sm text-slate-300">Searches, uploads, decisions and generated content stay visible and reusable.</p>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Sessions</p>
              <p class="mt-2 text-2xl font-bold text-white">12</p>
            </div>
            <div class="metric">
              <p class="text-xs uppercase tracking-[0.18em] text-slate-500">Artefacts</p>
              <p class="mt-2 text-2xl font-bold text-white">248</p>
            </div>
          </div>
          <div class="rounded-2xl border border-slate-800 bg-slate-950/70 p-4">
            <div class="flex items-center justify-between text-xs text-slate-400">
              <span>Recent items</span>
              <span>Organized by context</span>
            </div>
            <div class="mt-3 space-y-2">
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Project note · product decisions</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Prompt set · reusable workflow</div>
              <div class="rounded-xl border border-slate-800 bg-slate-900/70 px-3 py-2 text-sm text-slate-200">Uploaded doc · indexed and searchable</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      <article class="feature-card">
        <p class="eyebrow">Problem</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">Useful AI work gets lost.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Long chats, mixed artefacts and ad-hoc notes make it hard to revisit what was actually valuable.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Solution</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">A calm, organised layer.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Repero AI brings conversations, documents and generated output into a structured workspace.</p>
      </article>
      <article class="feature-card">
        <p class="eyebrow">Direction</p>
        <h2 class="mt-3 text-2xl font-semibold text-white">European-first by design.</h2>
        <p class="mt-3 text-sm leading-7 text-slate-300">Built around control, transparency and portability so the product feels trustworthy and durable.</p>
      </article>
    </section>
  </main>
  <Footer lang="en" />
</BaseLayout>
