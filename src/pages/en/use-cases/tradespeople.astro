---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = 'https://repero.ai';
const canonical = new URL('/en/use-cases/tradespeople', site).href;
const alternates = [{ lang: 'fr', href: new URL('/fr/cas-usages/techniciens', site).href }];
---
<UseCasePage
  lang="en"
  canonical={canonical}
  title="Tradespeople and technicians"
  description="Capture field knowledge and documentation."
  tags={["technicians", "repair technicians", "HVAC installers", "on-site work", "maintenance", "field service"]}
  items={["manuals", "installation documentation", "intervention notes", "supplier documentation", "equipment-specific knowledge"]}
  exampleTitle="Concrete example"
  exampleIntro="Field work is smoother when the manual, the intervention notes and the checklist stay in one project."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "I open the equipment manual and create a project around that equipment in Repero AI.",
    "I add intervention notes, supplier documents and the next maintenance steps.",
    "I ask Repero AI to prepare the work checklist for the next site visit.",
    "I store that checklist as an artefact tied to the equipment context.",
    "On the next intervention, I reopen the artefact and follow the same plan instead of starting from scratch."
  ]}
/>
