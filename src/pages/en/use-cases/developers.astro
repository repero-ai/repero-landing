---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = 'https://repero.ai';
const canonical = new URL('/en/use-cases/developers', site).href;
const alternates = [{ lang: 'fr', href: new URL('/fr/cas-usages/developpeurs', site).href }];
---
<UseCasePage
  lang="en"
  canonical={canonical}
  title="Developers"
  description="Keep technical work aligned across analysis, docs and implementation."
  tags={["developers", "technical teams", "architecture", "debugging", "technical documentation", "prompts"]}
  items={["code snippets", "requirements analysis", "architecture notes", "debugging sessions", "technical documentation", "reusable prompts and decisions"]}
  exampleTitle="Concrete example"
  exampleIntro="A technical project stays usable when the analysis, docs and tasks all live in the same place."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "I import the business analysis and create a project around it in Repero AI.",
    "I update the platform documentation with the requirements, assumptions and open decisions.",
    "I ask Repero AI to prepare the implementation checklist for the next sprint.",
    "I save that checklist as a product artefact so the team can reuse the same context.",
    "When I start coding, I follow the artefact instead of reopening scattered conversations."
  ]}
/>
