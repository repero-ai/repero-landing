---
import { type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { buildBlogIndexPath, buildBlogPostPath, formatBlogDate, getPublishedBlogPosts, getReadingTimeMinutes, getRelatedPosts } from '../../../lib/blog';
import { BRAND_LOGO, DEFAULT_OG_IMAGE, SITE_URL, absoluteUrl } from '../../../config/site';

export async function getStaticPaths() {
  const posts = await getPublishedBlogPosts();

  return posts.filter((post) => post.data.lang === 'fr').map((post) => ({
    params: { slug: post.slug },
    props: { post, posts }
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  posts: CollectionEntry<'blog'>[];
}

const { post, posts } = Astro.props;
const { Content } = await post.render();
const site = SITE_URL;
const canonicalPath = buildBlogPostPath(post);
const canonical = new URL(canonicalPath, site).href;
const englishPost = posts.find((candidate) => candidate.data.lang === 'en' && candidate.data.translationOf === post.slug);
const alternates = englishPost ? [{ lang: 'en' as const, href: new URL(buildBlogPostPath(englishPost), site).href }] : [];
const postImage = absoluteUrl(post.data.image ?? DEFAULT_OG_IMAGE);
const relatedPosts = getRelatedPosts(post, posts.filter((candidate) => candidate.data.lang === 'fr'));
const readingTime = getReadingTimeMinutes(post.body);
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedTime,
  dateModified: modifiedTime,
  inLanguage: post.data.lang,
  articleSection: post.data.category,
  keywords: post.data.tags,
  image: postImage,
  author: {
    '@type': 'Person',
    name: post.data.author
  },
  publisher: {
    '@type': 'Organization',
    name: 'Repero AI',
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl(BRAND_LOGO)
    }
  },
  mainEntityOfPage: canonical,
  url: canonical
};
---
<BaseLayout
  lang="fr"
  title={`${post.data.title} | Repero AI`}
  description={post.data.description}
  canonical={canonical}
  alternates={alternates}
  ogType="article"
  twitterCard="summary_large_image"
  ogImage={post.data.image ?? DEFAULT_OG_IMAGE}
  article={{
    publishedTime,
    modifiedTime,
    author: post.data.author,
    section: post.data.category,
    tags: post.data.tags
  }}
  schema={schema}
>
  <Header lang="fr" />
  <main class="page-shell pb-12">
    <section class="section-shell px-6 py-8 md:px-10 md:py-10">
      <a class="inline-flex items-center text-sm font-medium text-sky-300 hover:text-sky-200" href={buildBlogIndexPath('fr')}>
        ← Retour au blog
      </a>

      <div class="mt-6 max-w-3xl">
        <div class="flex flex-wrap items-center gap-3 text-sm text-slate-400">
          <span class="chip">{post.data.category}</span>
          <span>{formatBlogDate(post.data.pubDate)}</span>
          <span>{readingTime} min de lecture</span>
        </div>
        <h1 class="mt-5 text-4xl font-bold tracking-tight text-white md:text-5xl">{post.data.title}</h1>
        <p class="mt-5 text-lg leading-8 text-slate-300">{post.data.description}</p>
      </div>
    </section>

    <article class="section-shell mt-8 px-6 py-8 md:px-10 md:py-10">
      <div class="blog-prose max-w-3xl">
        <Content />
      </div>
    </article>

    {relatedPosts.length > 0 && (
      <section class="mt-8">
        <div class="mb-4">
          <p class="eyebrow">À lire ensuite</p>
          <h2 class="mt-2 text-2xl font-semibold text-white">Articles liés</h2>
        </div>
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {relatedPosts.map((relatedPost) => (
            <article class="feature-card">
              <div class="flex flex-wrap items-center gap-3 text-sm text-slate-400">
                <span class="chip">{relatedPost.data.category}</span>
                <span>{formatBlogDate(relatedPost.data.pubDate)}</span>
              </div>
              <h3 class="mt-4 text-xl font-semibold text-white">
                <a class="hover:text-sky-300" href={buildBlogPostPath(relatedPost)}>{relatedPost.data.title}</a>
              </h3>
              <p class="mt-3 text-sm leading-7 text-slate-300">{relatedPost.data.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer lang="fr" />
</BaseLayout>
