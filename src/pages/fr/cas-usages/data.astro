---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = 'https://repero.ai';
const canonical = new URL('/fr/cas-usages/data', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/use-cases/data-teams', site).href }];
---
<UseCasePage
  lang="fr"
  canonical={canonical}
  title="Équipes data"
  description="Structurer vos projets data."
  tags={["équipes data", "SQL", "PySpark", "dbt", "Databricks", "Fabric", "Python"]}
  items={["jeux de données", "extraits SQL / PySpark / dbt", "règles métier", "logique de transformation", "notes d’analyse"]}
  exampleTitle="Exemple concret"
  exampleIntro="Un projet data est plus simple à livrer quand le contexte source, l’analyse et le travail à faire restent ensemble."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "Je reçois un nouveau jeu de données et je crée un projet dans Repero AI avec le contexte source.",
    "Je saisis l’analyse business, les définitions des KPI et les hypothèses de calcul.",
    "Je demande à Repero AI de préparer les tâches nécessaires pour livrer le modèle de données.",
    "Je sauvegarde la liste obtenue comme artefact produit, réutilisable par toute l’équipe.",
    "Pendant la livraison, je rouvre l’artefact pour vérifier les règles et les actions déjà validées."
  ]}
/>
