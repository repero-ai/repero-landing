---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
const site = 'https://repero.ai';
const canonical = new URL('/fr/cas-usages', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/use-cases', site).href }];
---
<BaseLayout
  lang="fr"
  title="Cas d’usage | Repero AI"
  description="Cas d’usage Repero AI."
  canonical={canonical}
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
>
  <Header lang="fr" />
  <main class="page-shell py-10">
    <section class="surface">
      <p class="eyebrow">Cas d’usage</p>
      <h1 class="mt-3 text-4xl font-bold text-white md:text-5xl">Choisissez le flux qui correspond à votre façon de travailler.</h1>
      <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-300">Repero AI garde le même contexte attaché au travail, que vous gériez des tâches personnelles, une livraison technique, une analyse de données ou des opérations terrain.</p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/fr/cas-usages/quotidien">Vie quotidienne</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/fr/cas-usages/developpeurs">Développeurs</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/fr/cas-usages/data">Équipes data</a>
        <a class="feature-card hover:border-sky-500/40 hover:bg-slate-900" href="/fr/cas-usages/techniciens">Techniciens</a>
      </div>
    </section>
  </main>
  <Footer lang="fr" />
</BaseLayout>
