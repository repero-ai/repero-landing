---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = 'https://repero.ai';
const canonical = new URL('/fr/cas-usages/techniciens', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/use-cases/tradespeople', site).href }];
---
<UseCasePage
  lang="fr"
  canonical={canonical}
  title="Techniciens"
  description="Préparer les documents et informations pour aller sur le terrain."
  tags={["techniciens", "réparateurs", "chauffagistes", "installateurs airco", "dépanneurs", "maintenance terrain"]}
  items={["manuels", "documentation d’installation", "notes d’intervention", "documents fournisseurs", "connaissance spécifique aux équipements"]}
  exampleTitle="Exemple concret"
  exampleIntro="Faciliter votre travail chez et avec les clients."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "J’ouvre le manuel de l’équipement et je crée un projet autour de cet équipement dans Repero AI.",
    "J’ajoute les notes d’intervention, les documents fournisseurs et les prochaines étapes de maintenance.",
    "Je demande à Repero AI de préparer la liste de contrôle de la prochaine visite.",
    "Je stocke cette liste de contrôle comme artefact lié au contexte de l’équipement.",
    "Lors de la prochaine intervention, je rouvre l’artefact et je repars du même plan au lieu de repartir de zéro."
  ]}
/>
