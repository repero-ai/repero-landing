---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = 'https://repero.ai';
const canonical = new URL('/fr/cas-usages/quotidien', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/use-cases/everyday', site).href }];
---
<UseCasePage
  lang="fr"
  canonical={canonical}
  title="Vie quotidienne"
  description="Garder les sujets personnels organisés."
  tags={["organisation personnelle", "city trip", "projets familiaux", "dossiers administratifs", "achats importants", "rénovation"]}
  items={["city trip", "comparaison d’achats importants", "projets familiaux", "dossiers administratifs et documents personnels", "planification de rénovation"]}
  exampleTitle="Exemple concret"
  exampleIntro="Un city trip devient plus simple quand la conversation, les recherches et les décisions restent dans le même projet."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "Je démarre une conversation pour préparer un city trip à Madrid.",
    "Je transforme cette conversation en projet et j’y range le contexte du voyage.",
    "Je lance une recherche sur les points d’intérêt, puis je sauvegarde la shortlist dans le projet.",
    "Je cherche les moyens de paiement, l’aide pour le logement et les plats locaux à tester, puis je conserve chaque résultat comme artefact.",
    "Plus tard, je rouvre le projet et je retrouve tout le fil du voyage au même endroit."
  ]}
/>
