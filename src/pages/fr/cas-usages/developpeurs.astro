---
import UseCasePage from '../../../components/UseCasePage.astro';
const site = 'https://repero.ai';
const canonical = new URL('/fr/cas-usages/developpeurs', site).href;
const alternates = [{ lang: 'en', href: new URL('/en/use-cases/developers', site).href }];
---
<UseCasePage
  lang="fr"
  canonical={canonical}
  title="Développeurs"
  description="Aligner l’analyse, la documentation et l’implémentation."
  tags={["développeurs", "équipes techniques", "architecture", "débogage", "documentation technique", "Python", "Node", "Java"]}
  items={["snippets de code", "analyse des cahiers des charges", "notes d’architecture", "sessions de débogage", "documentation technique", "prompts et décisions réutilisables"]}
  exampleTitle="Exemple concret"
  exampleIntro="Un projet technique reste exploitable quand l’analyse, la documentation et les tâches vivent au même endroit."
  ogType="website"
  twitterCard="summary_large_image"
  alternates={alternates}
  exampleSteps={[
    "J’importe l’analyse business et je crée un projet autour dans Repero AI.",
    "Je mets à jour la documentation de la plateforme avec les exigences, les hypothèses et les décisions ouvertes.",
    "Je demande à Repero AI de préparer la liste des tâches pour le prochain sprint.",
    "Je sauvegarde cette liste comme artefact produit pour que l’équipe réutilise le même contexte.",
    "Quand j’attaque le dev, je m’appuie sur l’artefact au lieu de rouvrir des conversations éparpillées."
  ]}
/>
